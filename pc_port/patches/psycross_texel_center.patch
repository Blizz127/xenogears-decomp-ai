diff --git a/src/render/PsyX_render.cpp b/src/render/PsyX_render.cpp
--- a/src/render/PsyX_render.cpp
+++ b/src/render/PsyX_render.cpp
@@ -102,0 +103,15 @@
+/* _xeno_texel_center: independent opt-in for the PS1 nearest-sample
+ * center convention. The uniform is activated only for on-screen,
+ * non-PGXP textured draws; offscreen VRAM and PGXP remain unchanged. */
+static bool XenoPs1TexelCenterEnabled()
+{
+	static int enabled = -1;
+	if (enabled < 0)
+	{
+		const char* value = getenv("XENO_PS1_TEXEL_CENTER");
+		enabled = value != NULL && strcmp(value, "1") == 0;
+		if (enabled)
+			fprintf(stderr, "[PsyCross] PS1 texel-center correction enabled: (+0.5,+0.5)\n");
+	}
+	return enabled != 0;
+}
@@ -521,0 +537 @@
+	GLint texelCenterLoc; /* _xeno_texel_center_uniform */
@@ -538,0 +555,2 @@
+GLint u_texelCenterLoc = -1; /* _xeno_texel_center_loc_global */
+bool g_xeno_ps1_textured_sampling = false;
@@ -644,0 +663 @@
+	"		P += (ps1TexelCenter > 0) ? vec2(0.5, 0.5) : vec2(0.0, 0.0);\n"\
@@ -661,0 +681 @@
