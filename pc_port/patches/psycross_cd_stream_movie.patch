+#ifndef __EMSCRIPTEN__
+	if (g_cdSpoolerPCThread)
+	{
+		int returnValue;
+		SDL_WaitThread(g_cdSpoolerPCThread, &returnValue);
+		g_cdSpoolerPCThread = NULL;
+	}
+#endif
+	g_xeno_cdPaceNext = 0;
+}
