+/* _xeno_fixed_uv_option: exact PCSX-Redux 16.16 edge/span interpolation is
+ * opt-in and restricted again at draw time to marked on-screen, non-PGXP,
+ * genuine-PS1 textured polygon triangles. */
+static bool XenoPs1FixedUvEnabled()
+{
+	static int enabled = -1;
+	if (enabled < 0)
+	{
+		const char* value = getenv("XENO_PS1_FIXED_UV_INTERPOLATION");
+		enabled = value != NULL && strcmp(value, "1") == 0;
+		if (enabled)
+			fprintf(stderr, "[PsyCross] exact PS1 fixed-point polygon UV interpolation enabled\n");
+	}
+	return enabled != 0;
+}
