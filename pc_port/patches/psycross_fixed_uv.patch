diff --git a/src/render/PsyX_fixed_uv.h b/src/render/PsyX_fixed_uv.h
new file mode 100644
--- /dev/null
+++ b/src/render/PsyX_fixed_uv.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <stdint.h>
+
+/* _xeno_fixed_uv: CPU-side transcription of the PCSX-Redux software GPU's
+ * textured-triangle edge/span interpolation.  Rows are uploaded as two
+ * RGBA32I texels: seed/step, then first-X/valid plus padding. */
+struct XenoFixedUvVertex
+{
+	int16_t x;
+	int16_t y;
+	uint8_t u;
+	uint8_t v;
+};
+
+struct XenoFixedUvRow
+{
+	int32_t seedU;
+	int32_t seedV;
+	int32_t stepU;
+	int32_t stepV;
+	int32_t firstX;
+	int32_t valid;
+	int32_t reserved0;
+	int32_t reserved1;
+};
+
+bool XenoBuildFixedUvRows(const XenoFixedUvVertex vertices[3], int width,
+	int height, XenoFixedUvRow* rows);
diff --git a/src/render/PsyX_fixed_uv.cpp b/src/render/PsyX_fixed_uv.cpp
new file mode 100644
--- /dev/null
+++ b/src/render/PsyX_fixed_uv.cpp
@@ -0,0 +1,164 @@
+#include "PsyX_fixed_uv.h"
+
+#include <string.h>
+
+namespace
+{
+struct FixedVertex
+{
+	int32_t x;
+	int32_t y;
+	int32_t u;
+	int32_t v;
+};
+
+static int64_t ShiftRight16Floor(int64_t value)
+{
+	if (value >= 0)
+		return value / 0x10000;
+	return -((-value + 0xffff) / 0x10000);
+}
+
+static void SwapVertex(FixedVertex*& a, FixedVertex*& b)
+{
+	FixedVertex* temporary = a;
+	a = b;
+	b = temporary;
+}
+
+static bool FindSegment(FixedVertex** chain, int chainLength, int y,
+	FixedVertex*& start, FixedVertex*& end)
+{
+	for (int i = 0; i + 1 < chainLength; i++)
+	{
+		if (chain[i]->y <= y && y < chain[i + 1]->y)
+		{
+			start = chain[i];
+			end = chain[i + 1];
+			return true;
+		}
+	}
+	return false;
+}
+
+static int32_t EdgeX(const FixedVertex* start, const FixedVertex* end, int y)
+{
+	const int row = y - start->y;
+	const int height = end->y - start->y;
+	return start->x + (int64_t)(end->x - start->x) * row / height;
+}
+
+static int32_t EdgeUv(int32_t startValue, int32_t endValue, int row, int height)
+{
+	/* PCSX-Redux phase-20 behavior: truncate the signed 16.16 edge step
+	 * first, then accumulate that already-truncated step for each row. */
+	return startValue + (int64_t)row * ((endValue - startValue) / height);
+}
+}
+
+bool XenoBuildFixedUvRows(const XenoFixedUvVertex input[3], int width,
+	int height, XenoFixedUvRow* rows)
+{
+	if (input == NULL || rows == NULL || width <= 0 || height <= 0)
+		return false;
+
+	memset(rows, 0, sizeof(*rows) * height);
+
+	FixedVertex storage[3];
+	for (int i = 0; i < 3; i++)
+	{
+		storage[i].x = (int32_t)input[i].x * 0x10000;
+		storage[i].y = input[i].y;
+		storage[i].u = (int32_t)input[i].u * 0x10000;
+		storage[i].v = (int32_t)input[i].v * 0x10000;
+	}
+
+	FixedVertex* v1 = &storage[0];
+	FixedVertex* v2 = &storage[1];
+	FixedVertex* v3 = &storage[2];
+	/* These strict comparisons preserve PCSX-Redux's tie ordering. */
+	if (v1->y > v2->y) SwapVertex(v1, v2);
+	if (v1->y > v3->y) SwapVertex(v1, v3);
+	if (v2->y > v3->y) SwapVertex(v2, v3);
+
+	const int fullHeight = v3->y - v1->y;
+	if (fullHeight == 0)
+		return false;
+
+	const int32_t temp = ((int64_t)(v2->y - v1->y) * 0x10000) / fullHeight;
+	int32_t longest = (int64_t)temp * ((v3->x - v1->x) / 0x10000)
+		+ (v1->x - v2->x);
+	if (longest == 0)
+		return false;
+
+	FixedVertex* leftChain[3];
+	FixedVertex* rightChain[3];
+	int leftLength;
+	int rightLength;
+	if (longest < 0)
+	{
+		leftChain[0] = v1;
+		leftChain[1] = v3;
+		leftLength = 2;
+		rightChain[0] = v1;
+		rightChain[1] = v2;
+		rightChain[2] = v3;
+		rightLength = 3;
+		if (longest > -0x1000) longest = -0x1000;
+	}
+	else
+	{
+		leftChain[0] = v1;
+		leftChain[1] = v2;
+		leftChain[2] = v3;
+		leftLength = 3;
+		rightChain[0] = v1;
+		rightChain[1] = v3;
+		rightLength = 2;
+		if (longest < 0x1000) longest = 0x1000;
+	}
+
+	const int64_t numeratorU = (int64_t)temp * ((v3->u - v1->u) / 0x400)
+		+ (int64_t)(v1->u - v2->u) * 0x40;
+	const int64_t numeratorV = (int64_t)temp * ((v3->v - v1->v) / 0x400)
+		+ (int64_t)(v1->v - v2->v) * 0x40;
+	const int32_t stepU = (numeratorU * 0x400) / longest;
+	const int32_t stepV = (numeratorV * 0x400) / longest;
+
+	const int firstY = v1->y < 0 ? 0 : v1->y;
+	const int lastY = v3->y < height ? v3->y : height;
+	for (int y = firstY; y < lastY; y++)
+	{
+		FixedVertex* leftStart;
+		FixedVertex* leftEnd;
+		FixedVertex* rightStart;
+		FixedVertex* rightEnd;
+		if (!FindSegment(leftChain, leftLength, y, leftStart, leftEnd)
+			|| !FindSegment(rightChain, rightLength, y, rightStart, rightEnd))
+			continue;
+
+		const int leftRow = y - leftStart->y;
+		const int leftHeight = leftEnd->y - leftStart->y;
+		const int32_t leftX = EdgeX(leftStart, leftEnd, y);
+		const int32_t rightX = EdgeX(rightStart, rightEnd, y);
+		const int32_t leftU = EdgeUv(leftStart->u, leftEnd->u, leftRow, leftHeight);
+		const int32_t leftV = EdgeUv(leftStart->v, leftEnd->v, leftRow, leftHeight);
+
+		int firstX = (int)ShiftRight16Floor((int64_t)leftX + 0xffff);
+		int lastX = (int)ShiftRight16Floor((int64_t)rightX - 1);
+		if (firstX < 0) firstX = 0;
+		if (lastX >= width) lastX = width - 1;
+		if (lastX < firstX)
+			continue;
+
+		const int64_t gap = (int64_t)firstX * 0x10000 - leftX;
+		rows[y].seedU = leftU + ShiftRight16Floor(gap * stepU) + 0x8000;
+		rows[y].seedV = leftV + ShiftRight16Floor(gap * stepV) + 0x8000;
+		rows[y].stepU = stepU;
+		rows[y].stepV = stepV;
+		rows[y].firstX = firstX;
+		rows[y].valid = 1;
+	}
+
+	return true;
+}
