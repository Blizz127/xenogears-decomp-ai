+/* _xeno_raw_identity_option: opt-in exact raw-texture color identity. The
+ * uniform is enabled only for on-screen non-PGXP PS1-textured draws, while a
+ * dedicated per-vertex marker restricts the bypass to raw FT3/FT4 polygons. */
+static bool XenoPs1RawTextureIdentityEnabled()
+{
+	static int enabled = -1;
+	if (enabled < 0)
+	{
+		const char* value = getenv("XENO_PS1_RAW_TEXTURE_IDENTITY");
+		enabled = value != NULL && strcmp(value, "1") == 0;
+		if (enabled)
+			fprintf(stderr, "[PsyCross] PS1 raw-texture identity modulation enabled\n");
+	}
+	return enabled != 0;
+}
