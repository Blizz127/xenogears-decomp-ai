#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common"

APP=/home/blizz/apps/pcsx-redux/build293-3e10093a/PCSX-Redux-build293-3e10093a.AppImage
EXPECTED=b27a564e6c32333453433c950ac26e652f40af32d5e236441f36e8123c9c651b
ROOT="$ROOT" APP="$APP" EXPECTED="$EXPECTED" python3 - <<'PY'
import hashlib, os, pathlib, sys
app = pathlib.Path(os.environ["APP"])
if not app.is_file() or hashlib.sha256(app.read_bytes()).hexdigest() != os.environ["EXPECTED"]:
    print("PCSX-Redux checksum mismatch or AppImage missing", file=sys.stderr); raise SystemExit(2)
if not (pathlib.Path(os.environ["ROOT"]) / "disc/disc1.bin").is_file(): raise SystemExit(3)
PY
TMP="$(mktemp -d "$ROOT/.retail-validation.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
mkdir -p "$TMP/home" "$TMP/config" "$TMP/cache"
ARGS=("$ROOT/disc/disc1.bin")
if [ "${RETAIL_BIOS:-0}" = 1 ]; then
  ARGS=(--bios "$ROOT/disc/scph5500.bin" "${ARGS[@]}")
fi
XDG_CONFIG_HOME="$TMP/config" XDG_CACHE_HOME="$TMP/cache" HOME="$TMP/home" \
  timeout "${RETAIL_TIMEOUT:-15}s" xvfb-run -a "$APP" "${ARGS[@]}"
