#!/usr/bin/env bash
# Launch Xenogears native port and run until the genuine exit tuple
# (0x0400, 0x0E00, 1, 1) is reached, or timeout after 60 seconds.
# Validates the full boot -> field -> exit transition path.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

if [ -f "$REPO_ROOT/.env.local" ]; then
  set -a; . "$REPO_ROOT/.env.local"; set +a
fi

EXE="${XENO_BUILD_NATIVE:-$REPO_ROOT/pc_port/build_native/xeno-port}"
LIB="${XENO_LIB_ROOT:-/home/blizz/dev/xenogears-assets/lib}"
LOG_DIR="${XENO_LOG_ROOT:-/home/blizz/dev/xenogears-assets/logs}"
TIMEOUT="${XENO_EXIT_TIMEOUT:-60}"

if [ ! -x "$EXE" ]; then
  echo "ERROR: xeno-port binary not found: $EXE" >&2; exit 1
fi
if [ -z "${DISPLAY:-}" ]; then
  echo "ERROR: DISPLAY not set. Launch from graphical session." >&2; exit 1
fi

export LD_LIBRARY_PATH="${LIB:+$LIB:}${LD_LIBRARY_PATH:-}"
mkdir -p "$LOG_DIR"
STAMP="$(date +%Y%m%d-%H%M%S)"
LOG="$LOG_DIR/xeno-exit-$STAMP.log"

echo "[run-xeno-exit] timeout=${TIMEOUT}s, log=$LOG"
cd "$REPO_ROOT"
timeout "$TIMEOUT" "$EXE" 2>&1 | tee "$LOG"
RC=${PIPESTATUS[0]}

echo ""
echo "[run-xeno-exit] exit code: $RC"
if grep -q '0x0400.*0x0E00' "$LOG" 2>/dev/null; then
  echo "[run-xeno-exit] PASS: genuine exit tuple found"
elif [ "$RC" -eq 124 ]; then
  echo "[run-xeno-exit] TIMEOUT: did not reach exit within ${TIMEOUT}s"
else
  echo "[run-xeno-exit] process exited with code $RC"
fi
