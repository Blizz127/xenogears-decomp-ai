#!/usr/bin/env bash
# Open the captures directory in the file manager.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

if [ -f "$REPO_ROOT/.env.local" ]; then
  set -a; . "$REPO_ROOT/.env.local"; set +a
fi

CAPTURE_DIR="${XENO_CAPTURE_ROOT:-/home/blizz/dev/xenogears-assets/captures}"
mkdir -p "$CAPTURE_DIR"

echo "[open-captures] opening $CAPTURE_DIR"
exec xdg-open "$CAPTURE_DIR"
