#!/usr/bin/env bash
# Launch Xenogears native port with optional PS1 renderer accuracy corrections.
# Enables:
#   XENO_PS1_HALF_PIXEL_ORIGIN=1
#   XENO_PS1_TEXEL_CENTER=1
#   XENO_PS1_FIXED_UV_INTERPOLATION=1
# These are experimental — not the default launcher.
set -euo pipefail

export XENO_PS1_HALF_PIXEL_ORIGIN=1
export XENO_PS1_TEXEL_CENTER=1
export XENO_PS1_FIXED_UV_INTERPOLATION=1

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "[run-xeno-ps1-accurate] PS1 accuracy mode enabled"
echo "[run-xeno-ps1-accurate]   XENO_PS1_HALF_PIXEL_ORIGIN=1"
echo "[run-xeno-ps1-accurate]   XENO_PS1_TEXEL_CENTER=1"
echo "[run-xeno-ps1-accurate]   XENO_PS1_FIXED_UV_INTERPOLATION=1"

exec "$SCRIPT_DIR/run-xeno-port" "$@"
